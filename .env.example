# ── SAM Ultra Environment Variables ──────────────────────────────────────────
# Copy this to .env and fill in your values

# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=SAM
APP_VERSION=2.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# ── CORS (add your frontend URL) ─────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://your-domain.com"]

# ── AI Providers ─────────────────────────────────────────────────────────────
# Groq (required — free at console.groq.com)
GROQ_API_KEY=gsk_...

# OpenAI (optional — for GPT models)
OPENAI_API_KEY=sk-...

# Anthropic (optional — for Claude models)
ANTHROPIC_API_KEY=sk-ant-...

# ── Model Configuration ───────────────────────────────────────────────────────
MODEL_FAST=llama-3.1-8b-instant
MODEL_SMART=llama3-70b-8192
MODEL_REASON=deepseek-r1-distill-llama-70b
MODEL_VISION=llama-3.2-11b-vision-preview
MODEL_LONGCTX=mixtral-8x7b-32768

# ── Supabase (required for persistent memory) ─────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...

# ── Auth ─────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-32-char-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Redis (optional — improves performance) ───────────────────────────────────
REDIS_URL=redis://localhost:6379
USE_REDIS=false

# ── Voice ────────────────────────────────────────────────────────────────────
WHISPER_MODEL=whisper-large-v3-turbo
TTS_PROVIDER=browser

# ── Memory ───────────────────────────────────────────────────────────────────
MAX_CONVERSATION_TURNS=50
MAX_WORKING_MEMORY_TOKENS=4000

# ── Permissions ───────────────────────────────────────────────────────────────
# Level 3+ requires user confirmation before executing
REQUIRE_CONFIRMATION_LEVEL=3
